{
  "name": "learnquest-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "LearnQuest Jungle Run - Android and iOS apps (Capacitor)",
  "scripts": {
    "sync-web": "node scripts/sync-web.mjs",
    "sync": "npm run sync-web && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "assets": "capacitor-assets generate --android --ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0"
  }
}
